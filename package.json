{
  "name": "@ichava/motion",
  "version": "0.1.0",
  "description": "Framework-agnostic, JSON-driven SVG/icon animation engine. Vanilla, zero runtime dependencies, WAAPI + CSS, 240 presets across 40 families, data-* auto-init, optional Lottie import. Themable via CSS variables.",
  "license": "MIT",
  "author": "Simtabi LLC <hello@simtabi.com> (https://simtabi.com)",
  "homepage": "https://opensource.simtabi.com/products/ichava/motion",
  "keywords": [
    "animation",
    "motion",
    "svg",
    "icon",
    "waapi",
    "lottie",
    "vanilla",
    "framework-agnostic",
    "css-animation",
    "json"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "./dist/ichava-motion.js"
  ],
  "main": "./dist/ichava-motion.cjs",
  "style": "./dist/ichava-motion.css",
  "unpkg": "./dist/ichava-motion.js",
  "exports": {
    ".": {
      "types": "./dist/ichava-motion.d.ts",
      "import": "./dist/ichava-motion.mjs",
      "require": "./dist/ichava-motion.cjs",
      "default": "./dist/ichava-motion.mjs"
    },
    "./css": "./dist/ichava-motion.css",
    "./scss": "./src/ichava-motion.scss",
    "./lottie": "./dist/ichava-motion-lottie.js",
    "./presets": "./dist/presets.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "node scripts/gen-presets.mjs",
    "build": "node scripts/gen-presets.mjs && sass src/ichava-motion.scss dist/ichava-motion.css --no-source-map --style=expanded && vite build",
    "dev": "vite --open /demo/",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "vite": "^5.2.0"
  },
  "module": "./dist/ichava-motion.mjs",
  "jsdelivr": "./dist/ichava-motion.js"
}
